generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id               String       @id @default(cuid())
  telegramUsername String?      @unique
  name             String
  age              Int
  mood             String
  bottleDesign     BottleDesign
  language         String    @default("ru") // <-- ДОБАВЬТЕ ЭТУ СТРОКУ
    
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Meeting {
  id      String   @id @default(cuid())
  userAId String
  userBId String
  pairKey String
  dayKey  String
  metAt   DateTime @default(now())

  @@unique([pairKey, dayKey])
}

enum BottleDesign {
  EFES
  MILLER
  KRUZHKA_SVEZHEGO
  BELY_MEDVED
}
